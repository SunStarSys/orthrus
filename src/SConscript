# liborthrus: the one-time password library itself.

Import('env', 'VERSION', 'BUILD_DIR')

sources = [
    'core.c',
    'error.c',
    'hex.c',
    'words.c',
    'md4.c',
    'md5.c',
    'sha1.c',
    'userdb.c',
]

# Objects land beside this SConscript's variant dir; the library itself goes
# to the top of BUILD_DIR so every final artifact is a sibling.
lib = env.SharedLibrary(
    target='#%s/orthrus-%d' % (BUILD_DIR, VERSION.major),
    source=sources)

result = {
    'lib': lib,
    # srcnode() maps the variant-dir path back to src/*.c for the tarball.
    'dist_sources': [File(s).srcnode() for s in sources],
}

Return('result')
